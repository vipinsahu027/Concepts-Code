{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto-Detect and Run",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/.vscode/run_task.py"
            ],
            "options": {
                "env": {
                    "VSCODE_FILE": "${file}"
                }
            },
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
